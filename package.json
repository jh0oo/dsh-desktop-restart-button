  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "electron",
    "restart",
    "重启"
  ],
  "files": [
    "lib",
    "scripts",
    "assets",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml",
    "screenshots.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JH0oo/dsh-desktop-restart-button.git"
  },
  "homepage": "https://github.com/JH0oo/dsh-desktop-restart-button#readme",

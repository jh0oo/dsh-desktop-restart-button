{
  "name": "dsh-desktop-restart-button",
  "version": "0.1.0",
  "description": "A restart button in the DeepSeek Harness desktop title bar, plus an animated boot sequence that replaces the cold-start loading overlay. 桌面端标题栏一键重启，冷启动换成科技感动画。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "electron",
    "restart",
    "重启"
  ],
  "files": [
    "lib",
    "scripts",
    "assets",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml",
    "screenshots.json",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jh0oo/dsh-desktop-restart-button.git"
  },
  "homepage": "https://github.com/jh0oo/dsh-desktop-restart-button#readme",
  "bugs": {
    "url": "https://github.com/jh0oo/dsh-desktop-restart-button/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": ["win32"]
    }
  }
}
